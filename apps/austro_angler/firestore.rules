rules_version = '2';

// Sicherheitsregeln für Austro Angler.
// In der Firebase-Konsole unter Firestore → Regeln einfügen und veröffentlichen.
service cloud.firestore {
  match /databases/{database}/documents {

    function angemeldet() {
      return request.auth != null;
    }

    function ich(uid) {
      return angemeldet() && request.auth.uid == uid;
    }

    // Administrator (muss mit adminEmail in lib/services/konto.dart
    // übereinstimmen). Nur mit bestätigter E-Mail-Adresse.
    function istAdmin() {
      return angemeldet()
          && request.auth.token.email == 'snakejoni10@yahoo.com'
          && request.auth.token.email_verified == true;
    }

    // Felder, die ein Fang haben darf.
    function gueltigerFang(d) {
      return d.keys().hasOnly(['fischId', 'laengeCm', 'gewichtG', 'gewaesser',
               'bundesland', 'koeder', 'notiz', 'zurueckgesetzt', 'datum',
               'uid', 'nutzerName', 'hatFoto', 'petriHeil', 'erstellt',
               'wetter'])
          && d.uid == request.auth.uid
          && d.fischId is string && d.fischId.size() < 40
          && d.notiz is string && d.notiz.size() <= 500
          && d.koeder is string && d.koeder.size() <= 100
          && d.gewaesser is string && d.gewaesser.size() <= 100;
    }

    // Öffentliches Profil: nur der Name.
    match /nutzer/{uid} {
      allow read: if true;
      allow create, update: if ich(uid)
          && request.resource.data.keys().hasOnly(['name', 'erstellt'])
          && request.resource.data.name is string
          && request.resource.data.name.matches('^[a-z0-9_.]{3,20}$');
      allow delete: if ich(uid);

      // Freundesliste: nur der Besitzer.
      match /freunde/{freundUid} {
        allow read, delete: if ich(uid);
        allow create, update: if ich(uid)
            && request.resource.data.keys().hasOnly(['name', 'seit']);
      }

      // Fangorte: immer privat.
      match /fangorte/{fangId} {
        allow read, delete: if ich(uid);
        allow create, update: if ich(uid)
            && request.resource.data.keys().hasOnly(['lat', 'lng'])
            && request.resource.data.lat is number
            && request.resource.data.lng is number;
      }

      // Neuigkeiten (Petri Heil, Kommentare) – schreiben dürfen andere,
      // lesen nur der Besitzer.
      match /aktivitaeten/{id} {
        allow read, delete: if ich(uid);
        allow create: if angemeldet()
            && request.resource.data.keys().hasOnly(['von', 'nutzerName',
                 'typ', 'text', 'bezug', 'erstellt'])
            && request.resource.data.von == request.auth.uid
            && request.resource.data.typ in ['petri', 'kommentar']
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 150;
      }

      // Private Fänge: nur für den Besitzer.
      match /privat/{fangId} {
        allow read, delete: if ich(uid);
        allow create, update: if ich(uid) && gueltigerFang(request.resource.data);
      }
    }

    // Reservierte Nutzernamen (klein geschrieben), damit jeder Name nur
    // einmal vorkommt.
    match /namen/{name} {
      allow read: if true;
      allow create: if angemeldet()
          && name.matches('^[a-z0-9_.]{3,20}$')
          && request.resource.data.keys().hasOnly(['uid'])
          && request.resource.data.uid == request.auth.uid;
      allow delete: if angemeldet() && resource.data.uid == request.auth.uid;
    }

    // Öffentliche Fänge: alle dürfen lesen.
    match /faenge/{fangId} {
      allow read: if true;

      allow create: if angemeldet()
          && gueltigerFang(request.resource.data)
          && request.resource.data.petriHeil.size() == 0;

      // Besitzer bearbeitet seinen Fang (ohne die Petri-Heil-Liste).
      allow update: if ich(resource.data.uid)
          && gueltigerFang(request.resource.data)
          && request.resource.data.petriHeil == resource.data.petriHeil;

      // Andere sagen "Petri Heil!" oder nehmen es zurück – nur mit der
      // eigenen UID.
      allow update: if angemeldet()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['petriHeil'])
          && (
            request.resource.data.petriHeil.toSet()
                .difference(resource.data.petriHeil.toSet())
                == [request.auth.uid].toSet()
            || resource.data.petriHeil.toSet()
                .difference(request.resource.data.petriHeil.toSet())
                == [request.auth.uid].toSet()
          );

      allow delete: if ich(resource.data.uid) || istAdmin();

      // Kommentare unter öffentlichen Fängen.
      match /kommentare/{kommentarId} {
        allow read: if true;
        allow create: if angemeldet()
            && request.resource.data.keys()
                 .hasOnly(['uid', 'nutzerName', 'text', 'erstellt'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 500;
        allow delete: if ich(resource.data.uid) || istAdmin()
            || get(/databases/$(database)/documents/faenge/$(fangId)).data.uid
               == request.auth.uid;
      }
    }

    // Fotos (verkleinert, Base64).
    match /fotos/{fangId} {
      allow read: if resource.data.oeffentlich == true
          || ich(resource.data.uid);
      allow create: if angemeldet()
          && request.resource.data.keys().hasOnly(['uid', 'oeffentlich', 'daten'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.daten is string
          && request.resource.data.daten.size() < 500000;
      allow update: if ich(resource.data.uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.daten.size() < 500000;
      allow delete: if ich(resource.data.uid) || istAdmin();
    }

    // Meldungen: alle Angemeldeten dürfen melden, nur der Admin liest.
    match /meldungen/{id} {
      allow create: if angemeldet()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000;
      allow read, delete: if istAdmin();
    }

    // Preisvorschläge: Nutzer schlagen vor, der Admin prüft.
    match /preisvorschlaege/{id} {
      allow create: if angemeldet()
          && request.resource.data.keys().hasOnly(['uid', 'nutzerName',
               'gewaesserId', 'gewaesserName', 'art', 'euro', 'notiz',
               'erstellt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.euro is number
          && request.resource.data.euro >= 0
          && request.resource.data.euro <= 5000
          && request.resource.data.art is string
          && request.resource.data.art.size() <= 50
          && request.resource.data.notiz is string
          && request.resource.data.notiz.size() <= 300;
      allow read: if istAdmin() || ich(resource.data.uid);
      allow delete: if istAdmin();
    }

    // Vom Admin freigegebene Preise: alle lesen, nur der Admin schreibt.
    match /gepruefte_preise/{gewaesserId} {
      allow read: if true;
      allow write: if istAdmin();
    }

    // Gemeinsame Angeltage.
    match /treffen/{id} {
      allow read: if angemeldet();
      allow create: if angemeldet()
          && request.resource.data.keys().hasOnly(['uid', 'nutzerName',
               'gewaesser', 'zeit', 'text', 'zusagen'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.zeit is timestamp
          && request.resource.data.text.size() <= 300
          && request.resource.data.zusagen.keys().hasOnly([request.auth.uid]);
      // Zusagen/Absagen: nur den eigenen Eintrag ändern.
      allow update: if angemeldet()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['zusagen'])
          && request.resource.data.zusagen.diff(resource.data.zusagen)
               .affectedKeys().hasOnly([request.auth.uid]);
      allow delete: if ich(resource.data.uid) || istAdmin();
    }

    // Premium (z. B. Challenge-Gewinn): alle lesen, nur der Admin vergibt.
    match /premium/{uid} {
      allow read: if true;
      allow write: if istAdmin();
    }

    // Wünsche: jeder sieht seine eigenen, der Admin sieht alle und antwortet.
    match /wuensche/{id} {
      allow create: if angemeldet()
          && request.resource.data.keys()
               .hasOnly(['uid', 'nutzerName', 'text', 'status', 'erstellt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'neu'
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000;
      allow read: if istAdmin() || ich(resource.data.uid);
      allow update: if istAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'antwort']);
      allow delete: if istAdmin()
          || (ich(resource.data.uid) && resource.data.status == 'neu');
    }
  }
}
