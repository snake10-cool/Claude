<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_wurzel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_hintergrund"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_titel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎣 Austro Angler"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="App öffnen, um Beißzeit und Wetter zu laden."
        android:textColor="#E6F2EE"
        android:textSize="13sp" />
</LinearLayout>
