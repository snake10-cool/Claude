rules_version = '2';

// Sicherheitsregeln für Teilbar. In der Firebase-Konsole unter
// Firestore → Regeln einfügen und veröffentlichen.
service cloud.firestore {
  match /databases/{database}/documents {

    function angemeldet() {
      return request.auth != null;
    }

    function mitglied(gruppeId) {
      return angemeldet() &&
        request.auth.uid in get(/databases/$(database)/documents/gruppen/$(gruppeId)).data.mitglieder;
    }

    // Einladungscodes: nur gezielt lesbar (kein Auflisten aller Codes).
    match /einladungen/{code} {
      allow get: if angemeldet();
      allow list: if false;
      allow create: if angemeldet()
        && request.resource.data.keys().hasOnly(['gruppeId'])
        && code.size() == 6;
      allow update, delete: if false;
    }

    match /gruppen/{gruppeId} {
      allow read: if angemeldet() && request.auth.uid in resource.data.mitglieder;

      // Gründer legt die Gruppe mit sich selbst als einzigem Mitglied an.
      allow create: if angemeldet()
        && request.resource.data.mitglieder == [request.auth.uid];

      // Beitreten: nur sich selbst hinzufügen, mit gültigem Code dieser Gruppe.
      allow update: if angemeldet()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mitglieder', 'beitrittCode'])
        && request.resource.data.mitglieder.hasAll(resource.data.mitglieder)
        && request.resource.data.mitglieder.removeAll(resource.data.mitglieder).hasOnly([request.auth.uid])
        && get(/databases/$(database)/documents/einladungen/$(request.resource.data.beitrittCode)).data.gruppeId == gruppeId;

      allow delete: if false;

      match /objekte/{objektId} {
        allow read, write: if mitglied(gruppeId);
      }
    }
  }
}
